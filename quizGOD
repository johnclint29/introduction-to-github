import React, { useState } from 'react';
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";

const QuizCreator = () => {
  const [numQuestions, setNumQuestions] = useState(0);
  const [questions, setQuestions] = useState([]);

  const handleQuestionNumberChange = (e) => {
    const value = parseInt(e.target.value) || 0;
    setNumQuestions(value);
    const newQuestions = Array.from({ length: value }, (_, idx) => ({
      id: idx + 1,
      text: `Question ${idx + 1}`,
      options: ['', '', '', ''],
    }));
    setQuestions(newQuestions);
  };

  const handleQuestionTextChange = (idx, text) => {
    const updatedQuestions = [...questions];
    updatedQuestions[idx].text = text;
    setQuestions(updatedQuestions);
  };

  const handleOptionChange = (qIdx, oIdx, value) => {
    const updatedQuestions = [...questions];
    updatedQuestions[qIdx].options[oIdx] = value;
    setQuestions(updatedQuestions);
  };

  const handleSubmit = () => {
    console.log("Created Questions:", questions);
    alert("Quiz created! Check the console for the quiz data.");
  };

  return (
    <div className="container mx-auto p-4">
      <h1 className="text-2xl font-bold mb-4">Quiz Creator</h1>
      <div className="mb-4">
        <label htmlFor="numQuestions" className="block text-sm font-medium">
          Number of Questions:
        </label>
        <input
          id="numQuestions"
          type="number"
          min="1"
          className="mt-1 block w-full border p-2 rounded"
          value={numQuestions}
          onChange={handleQuestionNumberChange}
        />
      </div>
      <div className="space-y-4">
        {questions.map((q, qIdx) => (
          <Card key={q.id} className="bg-gray-100">
            <CardContent>
              <label htmlFor={`question-${q.id}`} className="block font-medium">
                {`Question ${q.id}`}
              </label>
              <input
                id={`question-${q.id}`}
                type="text"
                className="mt-1 block w-full border p-2 rounded"
                value={q.text}
                onChange={(e) => handleQuestionTextChange(qIdx, e.target.value)}
              />
              <div className="mt-4 space-y-2">
                {q.options.map((opt, oIdx) => (
                  <div key={oIdx} className="flex items-center">
                    <label
                      htmlFor={`q${qIdx}-opt${oIdx}`}
                      className="mr-2 font-medium"
                    >
                      {String.fromCharCode(65 + oIdx)}.
                    </label>
                    <input
                      id={`q${qIdx}-opt${oIdx}`}
                      type="text"
                      className="flex-1 border p-2 rounded"
                      value={opt}
                      onChange={(e) => handleOptionChange(qIdx, oIdx, e.target.value)}
                    />
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>
        ))}
      </div>
      {questions.length > 0 && (
        <Button className="mt-6 w-full" onClick={handleSubmit}>
          Create Quiz
        </Button>
      )}
    </div>
  );
};

export default QuizCreator;
